# Copy this file to .env for local use. Never commit real values.
AEGIS_LOG_LEVEL=INFO
AEGIS_FIXTURE_ROOT=tests/fixtures

# Reserved for V1 live connectors; leave blank during fixture-first development.
WAZUH_API_URL=
WAZUH_API_USERNAME=
WAZUH_API_PASSWORD=
SURICATA_EVE_PATH=
PFSENSE_SYSLOG_PATH=
COWRIE_JSON_PATH=

# Issue #11: read-only Indexer collector. Set in the process environment.
# This file is an example; the collector does not automatically load .env files.
WAZUH_INDEXER_URL=
WAZUH_INDEXER_USERNAME=
WAZUH_INDEXER_PASSWORD=
WAZUH_INDEXER_CA_FILE=
