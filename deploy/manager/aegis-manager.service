[Unit]
Description=AEGIS first-flow Manager WSGI (loopback only)
After=network.target postgresql.service

[Service]
Type=simple
User=aegis-manager
Group=aegis-manager
WorkingDirectory=/opt/aegis/current/manager
EnvironmentFile=/etc/aegis-manager/manager.env
ExecStart=/opt/aegis/venv/bin/gunicorn --bind localhost:8001 --workers 2 --access-logfile - --error-logfile - aegis_manager.wsgi:application
Restart=on-failure
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aegis-manager

[Install]
WantedBy=multi-user.target
