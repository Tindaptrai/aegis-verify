# PRIVATE copy: /etc/aegis-manager/manager.env root:aegis-manager 0640.
# systemd EnvironmentFile syntax, NOT shell source. Replace all placeholders.
DJANGO_SETTINGS_MODULE=aegis_manager.settings
AEGIS_MANAGER_SECRET_KEY=REPLACE_WITH_PRIVATE_RANDOM_SECRET_AT_LEAST_50_CHARACTERS
AEGIS_MANAGER_ALLOWED_HOSTS=REPLACE_MANAGER_HOSTNAME
AEGIS_MANAGER_PRIVATE_ROOT=/var/lib/aegis-manager
AEGIS_MANAGER_SIGNING_KEY=/var/lib/aegis-manager/keys/manager-signing.pem
AEGIS_MANAGER_DB_NAME=aegis_manager
AEGIS_MANAGER_DB_USER=aegis_manager
AEGIS_MANAGER_DB_PASSWORD=REPLACE_WITH_PRIVATE_DATABASE_PASSWORD
AEGIS_MANAGER_DB_HOST=localhost
AEGIS_MANAGER_DB_PORT=5432
# Optional trusted, root-owned, read-only standalone build (manager.html + assets).
# Leave unset for an explicit manager_ui_unavailable 503 at /manager/.
# Never set this to PRIVATE_ROOT, collectstatic, or the core dashboard dist.
AEGIS_MANAGER_UI_ROOT=/opt/aegis/current/frontend/dist-manager
