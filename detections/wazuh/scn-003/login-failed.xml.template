<!-- AEGIS SCN-003 LAB ONLY: one reviewed login-failure marker; install exactly one revision. -->
<group name="aegis_scn003,cowrie,">
  <rule id="120003" level="5">
    <if_group>$parent_group</if_group>
    <field name="eventid" type="pcre2">\Acowrie\.login\.failed\z</field>
    <field name="username" type="pcre2">\AAEGIS-SCN003-[0-9a-f]{8}\z</field>
    <description>AEGIS SCN-003 lab marker: one Cowrie login failure with the run username; not a compromise verdict.</description>
    <options>no_email_alert</options>
  </rule>
</group>
