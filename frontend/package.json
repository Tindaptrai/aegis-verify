{
  "name": "aegis-verify-dashboard",
  "private": true,
  "version": "0.4.0",
  "license": "Apache-2.0",
  "description": "Read-only results dashboard for AEGIS Verify CLI reports",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:manager": "tsc --noEmit -p tsconfig.json && vite build --config vite.manager.config.ts",
    "dev:manager": "vite --config vite.manager.config.ts --open manager.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.1.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.1"
  }
}
